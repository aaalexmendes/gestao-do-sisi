<?xml version="1.0" encoding="UTF-8"?>
<!-- Fotos das OMs: nenhum acesso direto (só pela api.php, rota=foto). -->
<configuration>
  <system.webServer>
    <handlers><clear /></handlers>
    <security>
      <authorization>
        <remove users="*" roles="" verbs="" />
        <add accessType="Deny" users="*" />
      </authorization>
    </security>
  </system.webServer>
</configuration>
